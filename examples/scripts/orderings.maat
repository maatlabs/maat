// Ordering operators (`<`, `>`, `<=`, `>=`) across
// every supported integer width, signed and unsigned.

// Unsigned widths
let a32: u32 = 7u32;
let b32: u32 = 42u32;
println!("{}", if a32 < b32 { 1i64 } else { 0i64 });
println!("{}", if a32 <= b32 { 1i64 } else { 0i64 });
println!("{}", if b32 > a32 { 1i64 } else { 0i64 });
println!("{}", if b32 >= a32 { 1i64 } else { 0i64 });

let a64: u64 = 1234567890u64;
let b64: u64 = 9876543210u64;
println!("{}", if a64 < b64 { 1i64 } else { 0i64 });
println!("{}", if a64 >= b64 { 1i64 } else { 0i64 });

let asz: usize = 0usize;
let bsz: usize = 65535usize;
println!("{}", if asz < bsz { 1i64 } else { 0i64 });
println!("{}", if asz <= asz { 1i64 } else { 0i64 });

// Signed widths, including across the zero boundary and both negative.
let s32a: i32 = -1000i32;
let s32b: i32 = 1000i32;
println!("{}", if s32a < s32b { 1i64 } else { 0i64 });
println!("{}", if s32b > s32a { 1i64 } else { 0i64 });

let s64a: i64 = -9223372036854775807i64;
let s64b: i64 = 9223372036854775807i64;
println!("{}", if s64a < s64b { 1i64 } else { 0i64 });
println!("{}", if s64a <= s64b { 1i64 } else { 0i64 });
println!("{}", if s64b >= s64a { 1i64 } else { 0i64 });

let neg_a: i64 = -42i64;
let neg_b: i64 = -7i64;
println!("{}", if neg_a < neg_b { 1i64 } else { 0i64 });
println!("{}", if neg_a >= neg_b { 1i64 } else { 0i64 });

let isz_a: isize = -1isize;
let isz_b: isize = 1isize;
println!("{}", if isz_a < isz_b { 1i64 } else { 0i64 });
println!("{}", if isz_b > isz_a { 1i64 } else { 0i64 });

// Boundary equality returns zero from `<` and one from `<=` / `>=`.
let eq_a: i64 = 42i64;
let eq_b: i64 = 42i64;
println!("{}", if eq_a < eq_b { 1i64 } else { 0i64 });
println!("{}", if eq_a <= eq_b { 1i64 } else { 0i64 });
println!("{}", if eq_a >= eq_b { 1i64 } else { 0i64 });
