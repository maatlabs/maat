// Basic example usage of `Vector<T>`.

// Build a vector by pushing primitive integers, one cell per push.
let mut v = Vector::new();
v = v.push(10);
v = v.push(20);
v = v.push(30);
v = v.push(40);

// Indexing reads from the per-instance segment.
println!("{}", v[0]);
println!("{}", v[1]);
println!("{}", v[2]);
println!("{}", v[3]);

// Inline length on the fat pointer.
println!("{}", v.len());

// Bounded iteration sums the elements.
let mut total: i64 = 0;
let n: usize = v.len();
for i in 0..n {
    total = total + v[i];
}
println!("{total}");

// The trailing Vector return publishes its cells to `SEG_PUBLIC_OUTPUT`.
v
